@model Practical_06.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Product Details</title>
</head>

<body style="font-family:Arial;
             background-color:#f5f5f5;
             margin:0;">

    <!-- Left Side Container -->
    <div style="width:650px;
                margin:40px 0 40px 40px;">

        <!-- Heading -->
        <h1 style="font-size:32px;
                   color:#222;
                   margin-bottom:25px;">
            Product Details
        </h1>

        <!-- Details Table -->
        <table border="1"
               cellpadding="15"
               cellspacing="0"
               width="100%"
               style="border-collapse:collapse;
                      background-color:white;
                      font-size:18px;
                      color:#222;">

            <!-- Product Image -->
            <tr>
                <td colspan="2"
                    style="text-align:center;
                           padding:20px;">

                    <img src="@Model.Image"
                         width="280"
                         height="220"
                         alt="@Model.ProductName"
                         style="object-fit:cover;
                                border-radius:8px;" />

                </td>
            </tr>

            <!-- Product ID -->
            <tr>
                <th style="width:35%;
                           text-align:left;
                           background-color:white;">
                    Product ID
                </th>

                <td>
                    <b>@Model.ProductId</b>
                </td>
            </tr>

            <!-- Product Name -->
            <tr>
                <th style="text-align:left;
                           background-color:white;">
                    Product Name
                </th>

                <td>
                    <b>@Model.ProductName</b>
                </td>
            </tr>

            <!-- Description -->
            <tr>
                <th style="text-align:left;
                           background-color:white;">
                    Description
                </th>

                <td>
                    @Model.Description
                </td>
            </tr>

            <!-- Price -->
            <tr>
                <th style="text-align:left;
                           background-color:white;">
                    Price
                </th>

                <td>
                    <b>₹ @Model.Price</b>
                </td>
            </tr>

            <!-- Category -->
            <tr>
                <th style="text-align:left;
                           background-color:white;">
                    Category
                </th>

                <td>
                    @Model.Category
                </td>
            </tr>

            <!-- Quantity -->
            <tr>
                <th style="text-align:left;
                           background-color:white;">
                    Quantity
                </th>

                <td>
                    @Model.Quantity
                </td>
            </tr>

        </table>

        <!-- Back Link -->
        <div style="margin-top:20px;">

            <a href="@Url.Action("Index", "ProductDefault")"
               style="font-size:18px;
                      color:#222;
                      font-weight:bold;
                      text-decoration:none;">

                ← Back to Product Catalog

            </a>

        </div>

    </div>

</body>
</html>