@model IEnumerable<Practical_06.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Catalog";
}

<h1>Product Catalog</h1>
<p>Available Products</p>

<table border="1" cellpadding="10" cellspacing="0" width="100%">
    <tr>
        <th>Product Image</th>
        <th>Product ID</th>
        <th>Product Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Category</th>
        <th>Quantity</th>
        <th>Action</th>
    </tr>

    @foreach (var product in Model)
    {
        <tr>
            <td>
                <img src="@product.Image" alt="@product.ProductName" width="100" height="80" />
            </td>
            <td>@product.ProductId</td>
            <td>@product.ProductName</td>
            <td>@product.Description</td>
            <td>₹ @product.Price</td>
            <td>@product.Category</td>
            <td>@product.Quantity</td>
            <td>
                <a href="@Url.Action("Details", "ProductDefault", new { id = product.ProductId })">
                    View Details
                </a>
            </td>
        </tr>
    }
</table>